# ==============================================================================
# Customer Support Agent — Environment Configuration
# ==============================================================================

# Application & Environment
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Cognition & Inference
# Backends: "mock" (default, zero-weight for dev/CI), "kev" (local), "jev", "groq"
DECISION_ENGINE_BACKEND=mock
KEV_ENDPOINT_URL=http://localhost:11434
GROQ_API_KEY=gsk_your_groq_api_key_here

# Slack Webhook for P0 / Escalation Alerts (Optional)
# If provided, escalations automatically post rich alert cards to your Slack channel
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXX

# Memory & State (PostgreSQL)
# Default points to local Docker Postgres container.
# For Supabase, replace with: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/customer_support

# Policy Knowledge Base (Qdrant)
# Points to local Docker container. Can also use ":memory:" for tests.
QDRANT_URL=http://localhost:6333

# Observability (OpenTelemetry & Jaeger)
OTEL_SERVICE_NAME=customer-support-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_CONSOLE_ENABLED=true
